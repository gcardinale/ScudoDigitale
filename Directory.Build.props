<Project>
  <!-- Settings shared by every project in the solution (docs/development/coding-rules.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Version>0.0.0</Version>
    <Authors>Gaetano Cardinale</Authors>
    <Product>Scudo Digitale</Product>
    <Copyright>© 2026 Gaetano Cardinale — https://gcardinale.it</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;it</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
