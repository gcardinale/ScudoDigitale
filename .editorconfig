root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# L'intestazione obbligatoria è in build/header.txt ed è verificata in CI
# (build/check-headers.ps1). Non usare file_header_template: non regge il riquadro ASCII.
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.CS1591.severity = error
