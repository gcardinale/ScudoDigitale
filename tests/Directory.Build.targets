<Project>
  <!--
    Coverage gate (CONTRIBUTING.md, rule 3): every `dotnet test` measures the assembly under test only and
    fails below 90% (total) for each type in CoverageThresholdTypes. Defined in .targets so that the
    .csproj can override AssemblyUnderTest, CoverageThresholdTypes and ModuleNotStarted.
    Our own exclusions never include CompilerGeneratedAttribute: it would hide the body of async
    methods. (coverlet.MTP adds it to its defaults; checked on 2026-11-15 that async state machines
    are still measured, e.g. CheckEngine.RunOneAsync.)
  -->
  <ItemGroup Condition="'$(ModuleNotStarted)' != 'true'">
    <_CoverageThresholdType Include="$(CoverageThresholdTypes.Split(' '))" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ModuleNotStarted)' != 'true'">
    <_CoverageThresholdArgs>@(_CoverageThresholdType->'--coverlet-threshold-type %(Identity)', ' ')</_CoverageThresholdArgs>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$(CoverageOutputDirectory)" --coverlet --coverlet-file-prefix $(MSBuildProjectName) --coverlet-include "[$(AssemblyUnderTest)]*" --coverlet-exclude-by-attribute GeneratedCodeAttribute --coverlet-exclude-by-attribute ExcludeFromCodeCoverageAttribute --coverlet-skip-auto-props --coverlet-threshold 90 $(_CoverageThresholdArgs) --coverlet-threshold-stat total --coverlet-output-format cobertura</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <!--
    A module with no code yet has no tests: exit code 8 ("zero tests ran") is accepted only here.
    Remove ModuleNotStarted from the .csproj together with the first test.
  -->
  <PropertyGroup Condition="'$(ModuleNotStarted)' == 'true'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
