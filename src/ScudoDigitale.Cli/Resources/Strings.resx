  <data name="RootDescription" xml:space="preserve">
    <value>Scudo Digitale: free, open-source security self-assessment of your network, Wi-Fi, websites, email, Bluetooth, GDPR and NIS2. Runs on your computer: nothing is sent to the author, and only public sources are queried.</value>
  </data>
  <data name="Disclaimer" xml:space="preserve">
    <value>This is a self-assessment tool: it does not replace a penetration test or legal advice. Use it only on systems you own or are authorized to check.</value>
  </data>
  <data name="UsageHint" xml:space="preserve">
    <value>Run "scudo scan --mail &lt;domain&gt;" to check the email setup of a domain, "scudo scan --web &lt;domain&gt;" to check its website, or "scudo --help" to see the options.</value>
  </data>
  <data name="ScanDescription" xml:space="preserve">
    <value>Runs the checks on the given targets and prints the results, most urgent first.</value>
  </data>
  <data name="MailOptionDescription" xml:space="preserve">
    <value>Domain whose email setup is checked (SPF, DMARC, DKIM, MX), using only public DNS; can be repeated.</value>
  </data>
  <data name="DkimSelectorOptionDescription" xml:space="preserve">
    <value>Extra DKIM selector to try besides the common ones (see the s= tag of the DKIM-Signature header); can be repeated.</value>
  </data>
  <data name="SystemDnsOptionDescription" xml:space="preserve">
    <value>Use only the DNS of this computer instead of Cloudflare and Google over HTTPS.</value>
  </data>
  <data name="OperatorOptionDescription" xml:space="preserve">
    <value>Name of the person running the assessment, printed in the declaration (default: the user name of this computer).</value>
  </data>
  <data name="RoleOptionDescription" xml:space="preserve">
    <value>Role of that person: Owner, SecurityOfficer or AppointedPerson (default: Owner).</value>
  </data>
  <data name="NoTargets" xml:space="preserve">
