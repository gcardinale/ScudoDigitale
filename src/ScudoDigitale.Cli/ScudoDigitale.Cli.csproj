<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>scudo</AssemblyName>
    <RootNamespace>ScudoDigitale.Cli</RootNamespace>
  </PropertyGroup>

  <!-- Release executables (dotnet publish -r <rid>): one file, .NET included, nothing to install.
       Not trimmed: Scriban, System.CommandLine and System.Text.Json use reflection. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Only the executable: no .pdb or .xml of the libraries next to it. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScudoDigitale.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ScudoDigitale.Cli.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScudoDigitale.Core\ScudoDigitale.Core.csproj" />
    <ProjectReference Include="..\ScudoDigitale.Checks.Email\ScudoDigitale.Checks.Email.csproj" />
    <ProjectReference Include="..\ScudoDigitale.Checks.Web\ScudoDigitale.Checks.Web.csproj" />
    <ProjectReference Include="..\ScudoDigitale.Compliance\ScudoDigitale.Compliance.csproj" />
    <ProjectReference Include="..\ScudoDigitale.Reporting\ScudoDigitale.Reporting.csproj" />
  </ItemGroup>

</Project>
