<Project>
  <!-- Central package versions: one place to update, no drift between parallel worktrees. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>
</Project>
