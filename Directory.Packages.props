<Project>
  <!-- Central package versions: one place to update, no drift between parallel worktrees. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <!-- 6.2.4 is the last MIT release: from 6.5 PDFsharp is AGPL + commercial and needs a license call at run time. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="Scriban" Version="7.6.1" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <!-- Transitive from PDFsharp 6.2.4, which asks for 8.0.1: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>
</Project>
